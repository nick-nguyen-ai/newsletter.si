# Copy to .dev.vars for `wrangler dev` (never commit .dev.vars).
AUTH_SECRET=local-dev-secret-change-me-0123456789abcdef
ALLOWED_ORIGINS=http://localhost:4000,http://127.0.0.1:4000
SITE_ORIGIN=http://localhost:4000
DEV_RETURN_LINK=1
# RESEND_API_KEY=   # leave unset locally: links are logged instead of emailed
